# Copy this file to .env and fill in your real values. Never commit .env.

# Capital.com credentials (Settings > API integrations, requires 2FA enabled first)
CAPITAL_IDENTIFIER=you@example.com
CAPITAL_API_KEY=your_api_key
CAPITAL_API_PASSWORD=your_api_key_password

# "demo" or "live". Always start with demo. Live requires --live AND this set to live.
CAPITAL_ENV=demo

# Instrument to trade (an "epic" code, e.g. from screen_instruments.py output).
EPIC=

# Strategy parameters
SMA_SHORT=20
SMA_LONG=50
# Minimum crossover separation, as a multiple of ATR, required to act on a signal.
# Tuned via backtest sweep across 4 instruments -- 0.02 was the best trade-off
# between filtering noise and keeping enough trades to be statistically meaningful.
MIN_SEPARATION_ATR_MULTIPLIER=0.02

# Risk management (percent of current account equity, not the number below)
RISK_PER_TRADE_PCT=1.0
DAILY_LOSS_LIMIT_PCT=5.0
MAX_DRAWDOWN_PCT=15.0
MAX_OPEN_POSITIONS=1

# How often the bot checks for a new signal, in minutes
POLL_INTERVAL_MINUTES=15

# Used only for display/sanity-check math; the bot always reads real balance from the API
STARTING_EQUITY_KZT=20000
